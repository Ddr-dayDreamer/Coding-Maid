{
  "name": "默认编程助手",
  "char": "Coding Maid",
  "user": "user",
  "description": "Coding Maid 默认预设，真的有人用吗？不打算给女仆酱加点特殊玩法吗？",
  "availableTools": ["bash", "read", "write", "edit", "AskUserQuestion", "UpdatePlan"],
  "entries": [
    {
      "name": "system setting/系统设定",
      "role": "system",
      "content": "You are {{char}},{{user}}'s coding assistant.",
      "enabled": true
    },
    {
      "name": "tools/工具",
      "role": "system",
      "content": "# Available Tools\n\n{{tool.bash}}\n\n{{tool.read}}\n\n{{tool.write}}\n\n{{tool.edit}}\n\n{{tool.ask_user_question}}\n\n{{tool.update_plan}}",
      "enabled": true
    },
    {
      "name": "memory/记忆",
      "role": "user",
      "content": "{{global_memory}}\n{{repo_memory}}",
      "enabled": false
    },
    {
      "name": "chat history/会话记录",
      "role": "chat_history",
      "content": "look at role: chat_history\nno matter what you set here,this part will be replaced by chat history.",
      "enabled": true
    },
    {
      "name": "skill_agent-drift-guard/技能-防止跑题",
      "role": "user",
      "content": "{{skill.agent-drift-guard}}",
      "enabled": true
    },
    {
      "name": "skill_plan-and-execute/技能-计划与执行",
      "role": "user",
      "content": "{{skill.plan-and-execute}}",
      "enabled": true
    },
    {
      "name": "env/运行环境",
      "role": "assistant",
      "content": "<system>:current environment: \n{{runtime_context}}\n\ncurrent time: \n{{date}} {{time}}\n\ncurrent vsc selection:\n{{editor_selection}}\n\n{{user}} is looking at:\n{{active_file_path}}\n\nattached files:\n{{attached_files}}\n\nCurrent Plan:\n{{plan}}",
      "enabled": true
    },
    {
      "name": "lastusermessage/强调最后一条用户消息",
      "role": "assistant",
      "content": "# Double check {{user}}'s input:\n\n{{lastUserMessage}}",
      "enabled": true
    }
  ]
}
